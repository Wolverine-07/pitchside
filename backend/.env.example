# Copy to .env and fill in. .env is ignored by git; never commit keys.
# templates | azure_openai | foundry | ollama
PITCHSIDE_PROVIDER=templates

# azure_openai: Foundry resource endpoint + key
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=

# foundry: project endpoint, signs in with your Azure identity (az login)
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>
PITCHSIDE_MODEL=gpt-4.1-mini
